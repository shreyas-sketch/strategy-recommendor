# ---------------- Required ----------------
ANTHROPIC_API_KEY=sk-ant-...
# ---------------- Admin sign-in ----------------
# Master admin account, created on first start. Sign in at /admin with this email + password
# (or "Sign in with Google" with the same email). The password must be 12+ characters.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
# Set to 1 once to reset a forgotten master password to MASTER_ADMIN_PASSWORD, then remove it.
# MASTER_ADMIN_PASSWORD_RESET=1
# Optional master-level API token (24+ random characters) for scripts / emergency access:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---------------- Google sign-in (optional) ----------------
# OAuth client from Google Cloud Console; redirect URI: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------- WhatsApp (AiSensy) ----------------
AISENSY_API_KEY=

# ---------------- Market data (optional; providers without keys are skipped) ----------------
TWELVEDATA_API_KEY=
# Groww — pick ONE login method. The app logs in itself and again after Groww's 06:00 IST daily reset.
#  a) TOTP key (Groww "Generate API key" -> TOTP): the API key + the TOTP secret shown with its QR code
GROWW_API_KEY=
GROWW_TOTP_SECRET=
#  b) Approval key: GROWW_API_KEY + GROWW_API_SECRET
GROWW_API_SECRET=
#  c) A pasted access token (expires every day at 06:00 — not recommended)
GROWW_ACCESS_TOKEN=
# Groww also supplies the F&O expiry calendar (needed for expiry-day strategies). Set to 0 to disable.
EXPIRY_CALENDAR=1

# ---------------- Deployment ----------------
# Where state lives. On Railway leave empty: the attached volume path is picked up automatically.
SR_DATA_DIR=
# Base URL used in invite links. On Railway leave empty to use the service's public domain.
PUBLIC_BASE_URL=
# Local development over plain http only — never set this in production.
# COOKIE_SECURE=0
# Set to 0 to disable the built-in 6 AM scheduler (e.g. if you run jobs via `python -m app.jobs`).
SCHEDULER_ENABLED=1
LOG_LEVEL=INFO
