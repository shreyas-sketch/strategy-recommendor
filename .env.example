# ---------------- Required ----------------
ANTHROPIC_API_KEY=sk-ant-...
# Admin panel login. Use a long random string (min 24 chars in production), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---------------- WhatsApp (AiSensy) ----------------
AISENSY_API_KEY=

# ---------------- Market data (optional; providers without keys are skipped) ----------------
TWELVEDATA_API_KEY=
# Groww: paste a daily access token, or give API key + secret and the app mints the token itself.
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
# Groww also supplies the F&O expiry calendar (needed for expiry-day strategies). Set to 0 to disable.
EXPIRY_CALENDAR=1

# ---------------- Deployment ----------------
# Where state lives. On Railway leave empty: the attached volume path is picked up automatically.
SR_DATA_DIR=
# Base URL used in invite links. On Railway leave empty to use the service's public domain.
PUBLIC_BASE_URL=
# Local development over plain http only — never set this in production.
# COOKIE_SECURE=0
# Set to 0 to disable the built-in 6 AM scheduler (e.g. if you run jobs via `python -m app.jobs`).
SCHEDULER_ENABLED=1
LOG_LEVEL=INFO
